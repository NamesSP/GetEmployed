pipeline {
    agent any

    environment {
        MAVEN_HOME = 'C:\\apache-maven-3.9.11' // Change path if needed
        PATH = "${MAVEN_HOME}\\bin;${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code..."
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                echo "Compiling code..."
                bat """
                    cd "${WORKSPACE}\\user-service"
                    mvn clean compile
                """
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
                bat """
                    cd "${WORKSPACE}\\user-service"
                    mvn test
                """
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis..."

                // Use the server configured in Jenkins → Configure System
                withSonarQubeEnv('MySonarQubeServer') {
                    bat """
                        cd "${WORKSPACE}\\user-service"
                        mvn sonar:sonar ^
                            -Dsonar.projectKey=user-service ^
                            -Dsonar.projectName=user-service ^
                            -Dsonar.host.url=%SONAR_HOST_URL% ^
                            -Dsonar.login=%SONAR_AUTH_TOKEN%
                    """
                }
            }
        }

        stage('Package') {
            steps {
                echo "Packaging application..."
                bat """
                    cd "${WORKSPACE}\\user-service"
                    mvn package -DskipTests
                """
            }
        }
    }

    post {
        success {
            echo '✅ Build, test, and Sonar analysis successful!'
        }
        failure {
            echo '❌ Build failed. Check logs for details.'
        }
    }
}
